#########
# Theming
#########
theme = light:Catppuccin Latte,dark:Catppuccin Macchiato
font-family = "Iosevka Medium"
font-family-bold = "Iosevka Bold"
font-size = 13
window-padding-x = 8
window-padding-y = 8
window-theme = ghostty

gtk-titlebar-style = tabs

background-opacity = 0.95
background-blur = true

##################
# General settings
##################
copy-on-select = clipboard
window-new-tab-position = end
mouse-hide-while-typing = true
app-notifications = no-clipboard-copy

# Start with a clean slate
keybind = clear

# Generic key binds
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+a>x=close_surface
keybind = ctrl+a>k=toggle_command_palette
keybind = ctrl+f=start_search

############
# Navigation
############

# Tabs
keybind = ctrl+a>t=new_tab
keybind = ctrl+a>[=previous_tab
keybind = ctrl+a>]=next_tab
keybind = ctrl+a>shift+[=move_tab:-1
keybind = ctrl+a>shift+]=move_tab:+1

# Panes
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>l=goto_split:right

keybind = ctrl+a>shift+h=new_split:left
keybind = ctrl+a>shift+j=new_split:down
keybind = ctrl+a>shift+k=new_split:up
keybind = ctrl+a>shift+l=new_split:right

# Index based navigation
keybind = ctrl+a>1=goto_tab:1
keybind = ctrl+a>2=goto_tab:2
keybind = ctrl+a>3=goto_tab:3
keybind = ctrl+a>4=goto_tab:4
keybind = ctrl+a>5=goto_tab:5
keybind = ctrl+a>6=goto_tab:6
keybind = ctrl+a>7=goto_tab:7
keybind = ctrl+a>8=goto_tab:8
keybind = ctrl+a>9=goto_tab:9
